<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">


    <TextView
        android:id="@+id/gameTitleMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.03"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="6"
        android:shadowRadius="10"
        android:text="@string/app_title"
        android:textColor="@color/palette_light_blue"
        android:textSize="56sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/gameSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:letterSpacing="0.08"
        android:text="@string/tagline_text"
        android:textAllCaps="true"
        android:textColor="@color/palette_slate_blue"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gameTitleMain" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/previewGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_preview_grid"
        android:padding="10dp"
        app:columnCount="4"
        app:rowCount="4"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gameSubtitle"
        app:layout_constraintWidth_percent="0.62">

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="0"
            app:layout_row="0" />

        <TextView
            style="@style/PreviewTile2"
            android:text="@string/tile_value_2"
            app:layout_column="1"
            app:layout_row="0" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="2"
            app:layout_row="0" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="3"
            app:layout_row="0" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="0"
            app:layout_row="1" />

        <TextView
            style="@style/PreviewTile4"
            android:text="@string/tile_value_4"
            app:layout_column="1"
            app:layout_row="1" />

        <TextView
            style="@style/PreviewTile8"
            android:text="@string/tile_value_8"
            app:layout_column="2"
            app:layout_row="1" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="3"
            app:layout_row="1" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="0"
            app:layout_row="2" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="1"
            app:layout_row="2" />

        <TextView
            style="@style/PreviewTile16"
            android:text="@string/tile_value_16"
            app:layout_column="2"
            app:layout_row="2" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="3"
            app:layout_row="2" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="0"
            app:layout_row="3" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="1"
            app:layout_row="3" />

        <TextView
            style="@style/PreviewTileEmpty"
            app:layout_column="2"
            app:layout_row="3" />

        <TextView
            style="@style/PreviewTile2"
            android:text="@string/tile_value_2"
            app:layout_column="3"
            app:layout_row="3" />

    </androidx.gridlayout.widget.GridLayout>

    <View
        android:id="@+id/buttonSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tv_NewGame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/previewGrid"
        app:layout_constraintVertical_weight="1" />

    <TextView
        android:id="@+id/tv_NewGame"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/new_game_text"
        android:textAllCaps="false"
        android:textColor="@color/palette_dark_navy"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/previewGrid" />
    <TextView
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/info_desc"
        android:textAllCaps="false"
        android:textColor="@color/palette_dark_navy"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_NewGame" />
    <TextView
        android:id="@+id/share"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/share_desc"
        android:textAllCaps="false"
        android:textColor="@color/palette_dark_navy"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/info" />

    <TextView
        android:id="@+id/tv_Continue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="@string/continue_text"
        android:textAllCaps="false"
        android:textColor="@color/palette_light_blue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/share" />

</androidx.constraintlayout.widget.ConstraintLayout>